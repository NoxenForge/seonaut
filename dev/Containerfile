FROM docker.io/library/golang:1.25-alpine3.22

RUN apk add --no-cache ca-certificates gcc git make musl-dev nodejs npm \
    && npm install --global esbuild@0.25.12 \
    && GOBIN=/usr/local/bin go install github.com/air-verse/air@v1.63.0

WORKDIR /app

CMD ["sh", "-c", "mkdir -p build/dev && exec air -c dev/air.toml"]
